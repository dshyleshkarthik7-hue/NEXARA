{
  "name": "nexara",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm --workspace @nexara/server run dev",
    "dev:web": "npm --workspace @nexara/web run dev",
    "build": "npm --workspace @nexara/web run build",
    "start": "npm --workspace @nexara/server start",
    "test": "node --test",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "fake-indexeddb": "^6.2.4"
  }
}
